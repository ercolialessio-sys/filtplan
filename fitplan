// ─── COMPONENTI ──────────────────────────────────────────────────
function Stars({n}){
return <span>{Array.from({length:5},(_,i)=><span key={i} style={{color:i<n?C.accent:”#333”,fontSize:11}}>★</span>)}</span>;
}

function Badge({label,color=”#e8ff3a”}){
return <span style={{background:`rgba(232,255,58,.12)`,color:color,fontSize:9,padding:“2px 8px”,letterSpacing:1,fontWeight:700,display:“inline-block”,marginBottom:5,border:`1px solid ${color}22`}}>{label}</span>;
}

function Esercizio({ex}){
const [open,setOpen]=useState(false);
const isCore=ex.nome.startsWith(“🔥”);
return(
<div style={{border:`1px solid ${C.border}`,borderLeft:`3px solid ${isCore?C.accent:C.orange}`,background:C.card,marginBottom:8,overflow:“hidden”}}>
<div onClick={()=>setOpen(v=>!v)} style={{padding:“12px 14px”,cursor:“pointer”,display:“flex”,justifyContent:“space-between”,alignItems:“flex-start”,gap:10}}>
