{ex.rec&&<span style={{background:”#222”,color:C.muted,padding:“2px 8px”,fontSize:10}}>{ex.rec}</span>}
</div>
</div>
<span style={{color:”#555”,fontSize:11,marginTop:2,transform:open?“rotate(180deg)”:“none”,transition:“transform .2s”}}>▼</span>
</div>
{open&&(
<div style={{borderTop:“1px solid #222”}}>
{ex.img&&<img src={ex.img} alt={ex.nome} style={{width:“100%”,maxHeight:200,objectFit:“cover”,objectPosition:“top”,display:“block”}} onError={e=>{e.target.style.display=“none”}}/>}
<div style={{padding:“10px 14px”}}>
